# Copy this file to terraform.tfvars and fill in your own values.
# terraform.tfvars is in .gitignore — NEVER commit it.

aws_region                = "us-east-1"
project_name              = "finops-guardian"
instance_type             = "t3.micro"

# Your public IP as a /32. Find it with: curl -s https://checkip.amazonaws.com
ssh_ingress_cidr          = "YOUR.PUBLIC.IP.HERE/32"
http_ingress_cidr         = "YOUR.PUBLIC.IP.HERE/32"
enable_ssh                = false

# Name of an EC2 key pair that already exists in your account.
# Leave it empty to administer the box through SSM Session Manager.
ssh_key_name              = ""

# Email that receives the budget alerts.
budget_notification_email = "you@example.com"
budget_limit_usd          = "1.0"
